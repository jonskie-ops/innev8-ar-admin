# Copy to .env.local (never committed) and fill in from your Supabase project:
# Project Settings → API Keys (and Data API for the URL).
SUPABASE_URL=https://your-project.supabase.co
# The publishable key (or the legacy "anon" key)
SUPABASE_PUBLISHABLE_KEY=
# The secret key (or the legacy "service_role" key). Server only: it can do anything. Never share it.
SUPABASE_SECRET_KEY=
